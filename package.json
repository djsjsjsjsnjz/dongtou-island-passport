{
  "name": "dongtou-island-passport",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll",
    "geo:fetch": "tsx scripts/fetch-osm.ts",
    "geo:process": "tsx scripts/process-geo.ts && tsx scripts/qa-geography.ts",
    "geo:check": "tsc -p tsconfig.scripts.json",
    "geo:bake": "tsx scripts/bake-terrain.ts",
    "geo:beach": "tsx scripts/build-beach-slice.ts",
    "geo:qa": "tsx scripts/qa-geography.ts",
    "test:performance": "node scripts/benchmark-map.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.6",
    "@types/osmtogeojson": "^2.2.34",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "^6.3.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
